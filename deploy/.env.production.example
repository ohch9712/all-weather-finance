# 서버에서 .env.production으로 복사하고 chmod 600. 실제 값은 커밋하지 않는다.
COMPOSE_PROJECT_NAME=finance
DOMAIN=
ACME_EMAIL=
# 운영 기본 포트. 다른 포트는 로컬 리허설에서만 사용한다.
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DB=finance
POSTGRES_USER=finance_migrator
POSTGRES_PASSWORD=
POSTGRES_APP_USER=finance_app
POSTGRES_APP_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_ENCRYPTION_KEY=
LLM_GENERAL_PROVIDER=gemini
LLM_PERSONAL_PROVIDER=gemini
GEMINI_BILLING_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
MARKET_DATA_PROVIDER=mock
KIWOOM_ENV=real
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
CODEF_ENV=production
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CHAT_DAILY_MESSAGE_LIMIT=100
IMPORT_MAX_FILE_MB=10
# 개인정보 처리방침 운영자 정보(/privacy). 하나라도 비면 화면에 "공개 전 초안" 경고가 나온다.
# 시행일은 YYYY-MM-DD. 실제 이름·연락처는 서버의 .env.production에만 넣고 커밋하지 않는다.
PRIVACY_OPERATOR_NAME=
PRIVACY_OFFICER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_HOSTING_PROVIDER=
PRIVACY_EFFECTIVE_DATE=
