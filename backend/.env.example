# 개발용 예시입니다. 실제 키는 .env에만 저장하세요.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://finance:finance_local_password@localhost:5433/finance_00
MIGRATION_DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=finance_session
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
APP_ENCRYPTION_KEY=
LLM_GENERAL_PROVIDER=disabled
LLM_PERSONAL_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BILLING_ENABLED=false
GEMINI_TIMEOUT_SECONDS=60
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_THINKING=true
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT_SECONDS=300
MARKET_DATA_PROVIDER=mock
KIWOOM_ENV=mock
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
CODEF_ENV=sandbox
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
CHAT_DAILY_MESSAGE_LIMIT=100
IMPORT_MAX_FILE_MB=10
